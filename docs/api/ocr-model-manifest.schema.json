{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-recipe.local/schemas/ocr-model-manifest.json",
  "title": "OcrModelManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "version",
    "engine",
    "platforms",
    "languages",
    "minAppVersion",
    "license",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "engine": {
      "const": "onnxruntime"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "android",
          "ios"
        ]
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "minAppVersion": {
      "$ref": "#/$defs/semanticVersion"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/modelFile"
      }
    },
    "runtimeConfig": {
      "$ref": "#/$defs/paddleOcrRuntimeConfig"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "not": {
          "required": [
            "runtimeConfig"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "required": [
          "runtimeConfig"
        ]
      }
    }
  ],
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "modelFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "downloadUrl",
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tensorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputName",
        "outputName"
      ],
      "properties": {
        "inputName": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "outputName": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scale",
        "mean",
        "standardDeviation",
        "colorOrder"
      ],
      "properties": {
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mean": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "standardDeviation": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "colorOrder": {
          "type": "string",
          "enum": [
            "bgr",
            "rgb"
          ]
        }
      }
    },
    "detectorRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelRole",
        "tensor",
        "resizeLongSide",
        "normalization",
        "pixelThreshold",
        "boxThreshold",
        "maxCandidates",
        "unclipRatio"
      ],
      "properties": {
        "modelRole": {
          "$ref": "#/$defs/role"
        },
        "tensor": {
          "$ref": "#/$defs/tensorBinding"
        },
        "resizeLongSide": {
          "type": "integer",
          "minimum": 32,
          "maximum": 4096
        },
        "normalization": {
          "$ref": "#/$defs/normalization"
        },
        "pixelThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "boxThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxCandidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "unclipRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        }
      }
    },
    "recognizerRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelRole",
        "dictionaryRole",
        "tensor",
        "imageShape",
        "normalization",
        "blankIndex",
        "useSpaceCharacter"
      ],
      "properties": {
        "modelRole": {
          "$ref": "#/$defs/role"
        },
        "dictionaryRole": {
          "$ref": "#/$defs/role"
        },
        "tensor": {
          "$ref": "#/$defs/tensorBinding"
        },
        "imageShape": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "const": 3
            },
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "items": false
        },
        "normalization": {
          "$ref": "#/$defs/normalization"
        },
        "blankIndex": {
          "type": "integer",
          "minimum": 0
        },
        "useSpaceCharacter": {
          "type": "boolean"
        }
      }
    },
    "paddleOcrRuntimeConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "detector",
        "recognizer"
      ],
      "properties": {
        "type": {
          "const": "paddleocr-ppocrv5"
        },
        "detector": {
          "$ref": "#/$defs/detectorRuntime"
        },
        "recognizer": {
          "$ref": "#/$defs/recognizerRuntime"
        }
      }
    }
  }
}
