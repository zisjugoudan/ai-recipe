{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-recipe.local/schemas/recipe-generation.schema.json",
  "title": "AI Recipe Generation Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "ingredients", "steps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": ["string", "null"], "maxLength": 4000 },
    "servings": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000 },
    "prepTimeMinutes": { "type": ["integer", "null"], "minimum": 0, "maximum": 10080 },
    "cookTimeMinutes": { "type": ["integer", "null"], "minimum": 0, "maximum": 10080 },
    "totalTimeMinutes": { "type": ["integer", "null"], "minimum": 0, "maximum": 20160 },
    "difficulty": { "type": ["string", "null"], "enum": ["unspecified", "easy", "medium", "hard", null] },
    "notes": { "type": ["string", "null"], "maxLength": 4000 },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "groupName": { "type": ["string", "null"], "maxLength": 100 },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "quantity": { "type": ["string", "null"], "maxLength": 100 },
          "unit": { "type": ["string", "null"], "maxLength": 50 },
          "optional": { "type": ["boolean", "null"] },
          "preparation": { "type": ["string", "null"], "maxLength": 500 },
          "substitutes": {
            "type": ["array", "null"],
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description"],
        "properties": {
          "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "durationSeconds": { "type": ["integer", "null"], "minimum": 0, "maximum": 86400 },
          "temperature": { "type": ["string", "null"], "maxLength": 100 },
          "heatLevel": { "type": ["string", "null"], "maxLength": 100 },
          "cookware": { "type": ["string", "null"], "maxLength": 200 },
          "tips": { "type": ["string", "null"], "maxLength": 1000 },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}